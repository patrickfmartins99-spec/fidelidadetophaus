{
  "rules": {
    ".read": false,
    ".write": false,

    "lojas": {
      "$unidade": {
        "usuarios_por_uid": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
            ".write": false
          }
        },

        "clientes": {
          ".read": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'gerente' && auth.token.unit === $unidade))",
          "$cpf": {
            ".write": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'gerente' && auth.token.unit === $unidade))",
            "almocos": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },

        "config": {
          "mensagens": {
            ".read": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'gerente' && auth.token.unit === $unidade))",
            ".write": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'gerente' && auth.token.unit === $unidade))"
          }
        },

        "fila_mensagens": {
          ".read": false,
          ".write": false
        },

        "auditoria": {
          ".read": "auth != null && auth.token.role === 'admin'",
          ".write": false
        },

        "contadores": {
          ".read": false,
          ".write": false
        }
      }
    }
  }
}
